{
  "name": "vscode-finder",
  "displayName": "Function Finder",
  "description": "Search all functions within the whole project",
  "version": "0.1.0",
  "publisher": "function-finder",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension/extension.js",
  "activationEvents": [
    "workspaceContains:.vscode/settings.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-finder.searchFunctions",
        "title": "Find Functions",
        "category": "Find Everything"
      },
      {
        "command": "vscode-finder.searchClasses",
        "title": "Find Classes",
        "category": "Find Everything"
      },
      {
        "command": "vscode-finder.searchVariables",
        "title": "Find Variables",
        "category": "Find Everything"
      },
      {
        "command": "vscode-finder.searchFields",
        "title": "Find Fields",
        "category": "Find Everything"
      },
      {
        "command": "vscode-finder.searchByLanguage",
        "title": "Find Functions by Language",
        "category": "Find Everything"
      },
      {
        "command": "vscode-finder.searchInFile",
        "title": "Find Functions in Current File",
        "category": "Find Everything"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-finder.searchFunctions",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "functionFinder",
          "name": "Function Finder",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "glob": "^10.0.0"
  }
}
